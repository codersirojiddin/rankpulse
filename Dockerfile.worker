# syntax=docker/dockerfile:1

# ---------- build stage ----------
FROM golang:1.22-alpine AS builder
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/worker ./cmd/worker

# ---------- runtime stage ----------
FROM alpine:3.19
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/worker ./worker

ENTRYPOINT ["./worker"]
